[
  {
    "id": "M1_3_001",
    "level": 1,
    "type": "CHOICE",
    "unit": "3단원 문자와 식 (기본)",
    "template": "x = {a}일 때, 다항식 {b}x + {c}의 값으로 옳은 것을 고르시오.",
    "param_rules": {
      "a": [2, 3, 4],
      "b": [3, 4, 5],
      "c": [1, 2, 5]
    },
    "options": [
      "({b} * {a}) + {c}",
      "({b} * {a}) - {c}",
      "({b} + {a}) + {c}",
      "({b} * {a}) + {c} + 2"
    ],
    "eval_script": "(b * a) + c",
    "explanation": "x = {a}를 식 {b}x + {c}에 대입하면 {b} × {a} + {c} = {ans}가 됩니다."
  },
  {
    "id": "M1_3_002",
    "level": 1,
    "type": "SHORT",
    "unit": "3단원 일차방정식 (기본)",
    "template": "일차방정식 {a}x + {b} = {c} 의 해 x를 구하시오.",
    "param_rules": {
      "a": [2, 3, 4],
      "b": [3, 5, 7],
      "c": [15, 17, 19]
    },
    "eval_script": "(c - b) / a",
    "explanation": "{a}x = {c} - {b} 이므로 {a}x = {c_minus_b}입니다. 양변을 {a}로 나누면 x = {ans}가 됩니다."
  },
  {
    "id": "M1_3_003",
    "level": 2,
    "type": "SHORT",
    "unit": "3단원 일차방정식 (중급 - 양변 미지수)",
    "template": "일차방정식 {a}x - {b} = {c}x + {d} 의 해 x를 구하시오.",
    "param_rules": {
      "a": [5, 6, 7],
      "c": [2, 3],
      "b": [2, 4, 6],
      "d": [10, 12, 14]
    },
    "eval_script": "(d + b) / (a - c)",
    "explanation": "미지수항을 좌변으로, 상수항을 우변으로 이항하면 ({a}-{c})x = {d}+{b} 이 됩니다. 따라서 x = {ans}입니다."
  },
  {
    "id": "M1_3_004",
    "level": 2,
    "type": "CHOICE",
    "unit": "3단원 일차방정식 활용 (중급 - 수 문제)",
    "template": "연속하는 세 자연수의 합이 {sum_val}일 때, 가장 큰 자연수를 고르시오.",
    "param_rules": {
      "sum_val": [21, 24, 27, 30, 33]
    },
    "options": [
      "(sum_val / 3) + 1",
      "sum_val / 3",
      "(sum_val / 3) - 1",
      "(sum_val / 3) + 2"
    ],
    "eval_script": "(sum_val / 3) + 1",
    "explanation": "연속하는 세 자연수를 x-1, x, x+1로 두면 합은 3x = {sum_val}이 되어 가운데 수는 {mid}입니다. 따라서 가장 큰 수는 {ans}입니다."
  },
  {
    "id": "M1_3_005",
    "level": 3,
    "type": "SHORT",
    "unit": "3단원 일차방정식 (상급 - 괄호와 대입)",
    "template": "일차방정식 {a}(x - {b}) = {c}x + {d} 의 해 x를 구하시오.",
    "param_rules": {
      "a": [4, 5, 6],
      "b": [2, 3],
      "c": [2, 3],
      "d": [10, 14, 18]
    },
    "eval_script": "(d + (a * b)) / (a - c)",
    "explanation": "괄호를 풀면 {a}x - {a*b} = {c}x + {d}가 됩니다. 정리하면 ({a}-{c})x = {d}+{a*b} 이므로 해 x = {ans}입니다."
  },
  {
    "id": "M1_3_006",
    "level": 3,
    "type": "SHORT",
    "unit": "3단원 일차방정식 활용 (상급 - 나이 문제)",
    "template": "현재 형의 나이는 {a}살, 동생의 나이는 {b}살이다. 형의 나이가 동생 나이의 2배가 되는 것은 몇 년 후(x)인지 구하시오.",
    "param_rules": {
      "a": [14, 16, 18],
      "b": [6, 7, 8]
    },
    "eval_script": "a - (2 * b)",
    "explanation": "x년 후 형 나이는 {a}+x, 동생 나이는 {b}+x입니다. 식: {a}+x = 2({b}+x) ➔ {a}+x = {2b}+2x ➔ x = {ans}년 후입니다."
  }
]