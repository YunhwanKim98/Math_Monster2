{
  "unit_id": "middle1_3",
  "unit_name": "방정식과 부등식",
  "levels": {
    "level_1": {
      "types": [
        {
          "type_id": "m1_3_l1_01",
          "question": "다음 중 일차방정식 x + 3 = 7의 해는?",
          "options": ["x = 2", "x = 3", "x = 4", "x = 5"],
          "answer": "x = 4",
          "explanation": "x = 7 - 3 이므로 x = 4 입니다."
        },
        {
          "type_id": "m1_3_l1_02",
          "question": "방정식 2x = 10의 해는?",
          "options": ["x = 2", "x = 5", "x = 8", "x = 20"],
          "answer": "x = 5",
          "explanation": "양변을 2로 나누면 x = 5 입니다."
        }
      ]
    },
    "level_2": {
      "types": [
        {
          "type_id": "m1_3_l2_01",
          "question": "일차방정식 3x - 5 = 10의 해는?",
          "options": ["x = 3", "x = 5", "x = 15", "x = 4"],
          "answer": "x = 5",
          "explanation": "-5를 이항하면 3x = 15가 되고, 양변을 3으로 나누면 x = 5 입니다."
        },
        {
          "type_id": "m1_3_l2_02",
          "question": "일차방정식 5x + 2 = 2x + 11의 해는?",
          "options": ["x = 1", "x = 2", "x = 3", "x = 4"],
          "answer": "x = 3",
          "explanation": "x 항을 좌변으로, 상수를 우변으로 이항하면 3x = 9 가 되어 x = 3 입니다."
        }
      ]
    },
    "level_3": {
      "types": [
        {
          "type_id": "m1_3_l3_01",
          "question": "방정식 2(x - 3) = 4의 해는?",
          "options": ["x = 4", "x = 5", "x = 6", "x = 7"],
          "answer": "x = 5",
          "explanation": "괄호를 풀면 2x - 6 = 4 이고, 2x = 10 이 되므로 x = 5 입니다."
        },
        {
          "type_id": "m1_3_l3_02",
          "question": "방정식 0.3x + 0.2 = 1.1의 해는?",
          "options": ["x = 2", "x = 3", "x = 4", "x = 5"],
          "answer": "x = 3",
          "explanation": "양변에 10을 곱하면 3x + 2 = 11 이고, 3x = 9 가 되므로 x = 3 입니다."
        }
      ]
    }
  }
}
