{
  "grade": "middle1",
  "term": 3,
  "unit_id": "m1_u3",
  "unit_name": "일차방정식",
  "levels": {
    "level_1": {
      "description": "방정식의 해 확인하기",
      "types": [
        {
          "type_id": "type_1",
          "type_name": "대입을 통한 해 찾기",
          "question": "다음 중 x = 2가 해인 방정식은?",
          "options": ["x + 3 = 4", "2x - 1 = 3", "3x = 9", "x + 2 = 5"],
          "answer": "2x - 1 = 3",
          "explanation": "2(2) - 1 = 3 이 성립합니다."
        }
      ]
    },
    "level_2": {
      "description": "등식의 성질",
      "types": [
        {
          "type_id": "type_1",
          "type_name": "등식의 양변 변형",
          "question": "a = b일 때 다음 중 옳지 않은 것은?",
          "options": ["a + 2 = b + 2", "a - 3 = b - 3", "5a = 5b", "a + 1 = b - 1"],
          "answer": "a + 1 = b - 1",
          "explanation": "양변에 같은 수를 더하거나 빼야 등식이 성립합니다."
        }
      ]
    },
    "level_3": {
      "description": "이항과 단순 일차방정식",
      "types": [
        {
          "type_id": "type_1",
          "type_name": "기본 이항 계산",
          "question": "방정식 x - 5 = 3의 해는?",
          "options": ["x = 2", "x = 8", "x = -2", "x = -8"],
          "answer": "x = 8",
          "explanation": "x = 3 + 5 이므로 x = 8입니다."
        }
      ]
    },
    "level_4": {
      "description": "일반 일차방정식 풀이",
      "types": [
        {
          "type_id": "type_1",
          "type_name": " ax + b = c 형태",
          "question": "방정식 3x + 4 = 13의 해는?",
          "options": ["x = 2", "x = 3", "x = 4", "x = 5"],
          "answer": "x = 3",
          "explanation": "3x = 9 -> x = 3입니다."
        }
      ]
    },
    "level_5": {
      "description": "괄호가 있는 일차방정식",
      "types": [
        {
          "type_id": "type_1",
          "type_name": "분배법칙 적용",
          "question": "방정식 2(x - 3) = 8의 해는?",
          "options": ["x = 5", "x = 7", "x = 8", "x = 10"],
          "answer": "x = 7",
          "explanation": "2x - 6 = 8 -> 2x = 14 -> x = 7입니다."
        }
      ]
    },
    "level_6": {
      "description": "계수가 소수/분수인 일차방정식",
      "types": [
        {
          "type_id": "type_1",
          "type_name": "소수 계수 정수화",
          "question": "방정식 0.3x - 0.2 = 0.7의 해는?",
          "options": ["x = 1", "x = 2", "x = 3", "x = 4"],
          "answer": "x = 3",
          "explanation": "양변에 10을 곱하면 3x - 2 = 7 -> 3x = 9 -> x = 3입니다."
        }
      ]
    },
    "level_7": {
      "description": "복합 계수 일차방정식",
      "types": [
        {
          "type_id": "type_1",
          "type_name": "분수와 괄호 혼합",
          "question": "방정식 1/2(x + 1) = 3의 해는?",
          "options": ["x = 4", "x = 5", "x = 6", "x = 7"],
          "answer": "x = 5",
          "explanation": "양변에 2를 곱하면 x + 1 = 6 -> x = 5입니다."
        }
      ]
    },
    "level_8": {
      "description": "일차방정식의 활용 - 수에 관한 문제",
      "types": [
        {
          "type_id": "type_1",
          "type_name": "연속하는 두 정수",
          "question": "연속하는 두 정수의 합이 21일 때, 두 정수 중 큰 수는?",
          "options": ["10", "11", "12", "13"],
          "answer": "11",
          "explanation": "x + (x + 1) = 21 -> 2x = 20 -> 작은 수 x = 10, 큰 수 = 11입니다."
        }
      ]
    },
    "level_9": {
      "description": "일차방정식의 활용 - 속도/거리 문제",
      "types": [
        {
          "type_id": "type_1",
          "type_name": "거리, 속력, 시간",
          "question": "시속 60km로 x시간 동안 이동한 거리가 180km일 때, x의 값은?",
          "options": ["2", "3", "4", "5"],
          "answer": "3",
          "explanation": "거리 = 속력 × 시간이므로 60x = 180 -> x = 3입니다."
        }
      ]
    },
    "level_10": {
      "description": "일차방정식 심화/해의 조건",
      "types": [
        {
          "type_id": "type_1",
          "type_name": "상수 k 구하기",
          "question": "x에 대한 방정식 2x + a = 10의 해가 x = 3일 때, a의 값은?",
          "options": ["2", "4", "6", "8"],
          "answer": "4",
          "explanation": "x = 3을 대입하면 2(3) + a = 10 -> 6 + a = 10 -> a = 4입니다."
        }
      ]
    }
  }
}
